{
  "$schema": "https://c0dn.github.io/ocws/schema/pack.schema.json",
  "schemaVersion": 3,
  "id": "reviewer",
  "displayName": "Reviewer agent",
  "componentType": "agent-pack",
  "version": "1.0.0",
  "description": "A read-only code review subagent.",
  "harnesses": [
    "opencode"
  ],
  "files": [
    {
      "source": "reviewer.md",
      "destination": "{agents}/reviewer.md"
    }
  ],
  "targets": {
    "claude": {
      "files": [
        {
          "source": "reviewer.md",
          "destination": "{agents}/reviewer.md",
          "render": "frontmatter",
          "header": "harness/claude/reviewer.yaml"
        }
      ]
    },
    "codex": {
      "files": [
        {
          "source": "reviewer.md",
          "destination": "{agents}/reviewer.toml",
          "render": "codex-agent",
          "header": "harness/codex/reviewer.toml"
        }
      ]
    }
  }
}
